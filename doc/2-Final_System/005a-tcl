# Tool Chain: TCL
# Build and install as mlfs
# Can be optional: Package used for testing final system packages

cd unix

# Create a cache file to configure
# the source to build with cross-tools
cp -v ../../files/ct-config.cache config.cache

# Configure source
ac_cv_func_strtod=yes \
tcl_cv_strtod_buggy=1 \
./configure --build=${MLFS_HOST} \
            --host=${MLFS_TARGET} \
            --prefix=/tools \
            --cache-file=config.cache 

# Build and install to toolchain
make && make install

# Install Headers and create link
chmod -v u+w /tools/lib/libtcl8.6.so
make install-private-headers
ln -sv tclsh8.6 /tools/bin/tclsh
