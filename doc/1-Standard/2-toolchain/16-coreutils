# Toolchain: Coreutils
# Build and install as mlfs

# Re-create configure script ... often fails, so it may be omited if it fails
# Will need to unpack again if it fails
autoreconf -vif

# Gnulib tests need to use linux/limits.h for
# a defined PATH_MAX 
patch -Np1 -i ../patches/coreutils-mlfs/fix_gnulib_header_path.patch 

# Configure source
./configure --prefix=/tools \
            --enable-install-program=hostname 

# Build and install to toolchain
make && make install
