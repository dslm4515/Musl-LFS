# Cross-Tools: GNU Binutils
# Build and install as mlfs

# Create build directory in-tree
mkdir -v build && cd build

# configure source
../configure \
   --prefix=/cross-tools \
   --target=${MLFS_TARGET} \
   --with-sysroot=/cross-tools/${MLFS_TARGET} \
   --disable-nls \
   --disable-multilib \
   --disable-werror \
   --enable-deterministic-archives \
   --disable-compressed-debug-sections \
   --enable-gprofng=no \
   --enable-new-dtags \
   --disable-bootstrap \
   --enable-relro \
   --enable-default-pie \
   --enable-static-pie \
   --disable-werror --disable-linker-build-id --enable-default-hash-style="sysv" 

# build to check host can build
make configure-host

# Build
make all-binutils all-gas all-ld

# Install
make install-strip-binutils install-strip-gas install-strip-ld
