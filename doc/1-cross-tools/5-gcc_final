# Cross-Tools: GCC Final
# Build and install as mlfs

# NOTE: Use build directory from earlier

# For CMLFS-based hosts, don't forget to add PATH 
# of the host's GCC to the make commands below
# PATH=/cross-tools/bin:/opt/gnu/bin:/usr/bin  

# Clean build target
make -C ${MLFS_TARGET}/libgcc distclean

# Make sure runtime objects can be found
mv /cross-tools/${MLFS_TARGET}/lib/* /cross-tools/lib/
rm -rf /cross-tools/${MLFS_TARGET}/lib
ln -sv ../lib /cross-tools/${MLFS_TARGET}/lib

# Rebuild libgcc as shared
make enable_shared=yes all-target-libgcc

# Installed shared libgcc without debugging symbols
make install-strip-target-libgcc

# Build libstdc++
make all-target-libstdc++-v3

# Install libstdc++ without debugging symbols
make install-strip-target-libstdc++-v3 

# OPTIONAL: Build & install libgomp 
make all-target-libgomp
make install-strip-target-libgomp

# OPTIONAL: Build & install libquadmath
make all-target-libquadmath
make install-strip-target-libquadmath

