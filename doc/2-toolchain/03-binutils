# Tool Chain: Binutils
# Build and install as mlfs

# Compile in dedicated build directory
mkdir -v build && cd build

# Create a cache file to configure
# the source to build with cross-tools
cat > config.cache << EOF
CC="${MLFS_TARGET}-gcc"
CXX="${MLFS_TARGET}-g++"
AR="${MLFS_TARGET}-ar"
AS="${MLFS_TARGET}-as"
RANLIB="${MLFS_TARGET}-ranlib"
LD="${MLFS_TARGET}-ld"
STRIP="${MLFS_TARGET}-strip"
CC_FOR_BUILD="${MLFS_TARGET}-gcc"
CXX_FOR_BUILD="${MLFS_TARGET}-g++"
AR_FOR_BUILD="${MLFS_TARGET}-ar"
AS_FOR_BUILD="${MLFS_TARGET}-as"
RANLIB_FOR_BUILD="${MLFS_TARGET}-ranlib"
LD_FOR_BUILD="${MLFS_TARGET}-ld"
STRIP_FOR_BUILD="${MLFS_TARGET}-strip"
EOF

# Configure
../configure --prefix=/tools            \
             --with-lib-path=/tools/lib \
             --build=${MLFS_HOST}       \
             --host=${MLFS_TARGET}      \
             --target=${MLFS_TARGET}    \
             --disable-nls              \
             --disable-werror           \
             --with-sysroot \
             --cache-file=config.cache
# Build
make

# Install
make install

# Build and install linker that will be used later 
# after adjusting toolchain
make -C ld clean
make -C ld LIB_PATH=/usr/lib:/lib 
cp -v ld/ld-new /tools/bin

