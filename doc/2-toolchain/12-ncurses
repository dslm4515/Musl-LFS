# Toolchain: Ncurses
# Build and install as mlfs

# Ensure that gawk is found first during configuration: 
sed -i s/mawk// configure

# First build the tic utility on the build host, per LFS
mkdir build
pushd build
../configure 
make -C include
make -C progs tic
popd

# Configure source
./configure --prefix=/tools \
    --build=${MLFS_HOST} \
    --host=${MLFS_TARGET} \
    --with-shared   \
    --without-debug \
    --without-ada   \
    --enable-widec  \
    --enable-overwrite     

# Build and install to toolchain
make && make install
