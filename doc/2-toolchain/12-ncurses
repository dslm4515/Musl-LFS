# Toolchain: Ncurses
# Build and install as mlfs

# Ensure that gawk is found first during configuration: 
sed -i s/mawk// configure

# First build the tic utility on the build host, per LFS
mkdir build
pushd build
../configure 
make -C include
make -C progs tic
popd

# Configure source
./configure --prefix=/tools \
    --build=${MLFS_HOST} \
    --host=${MLFS_TARGET} \
    --with-manpage-format=normal \
    --with-shared   \
    --with-cxx-shared \
    --without-debug \
    --without-normal \
    --without-ada   \
    --enable-widec  \
    --enable-overwrite \
    --disable-stripping    

# Build and install to toolchain
make && make TIC_PATH=$(pwd)/build/progs/tic install
ln -sv libncursesw.so /tools/lib/libncurses.so

# Edit the header so the wide-character data structure 
# definition will be compatible with libncursew.so
sed -e 's/^#if.*XOPEN.*$/#if 1/' \
    -i /tools/include/curses.h

