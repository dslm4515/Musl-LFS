# Prebuilt Toolchain: Update Coreutils
# Build and install under chroot

# Configure source
FORCE_UNSAFE_CONFIGURE=1 \
./configure --prefix=/tools --enable-install-program=hostname 

# Build
make

# Install to a temporary directory as 
# install my fail while binaries are 
# overwritten
make DESTDIR=/tmp/coreutils install

# Install via copying
src/cp -rv /tmp/coreutils/tools/* /tools/

# Clean up
rm -rf /tmp/coreutils
