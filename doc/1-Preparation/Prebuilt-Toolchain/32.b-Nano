# Prebuilt Toolchain: Update Nano
# Build and install under chroot

# NOTE: Optional, if nano is preferred
# over vim

# Set flags, so curses headers can be 
# found in /tools/include and curses
# liraries in /tools/lib
export LDFLAGS="-Wl,--copy-dt-needed-entries -L/tools/lib -lncursesw "
export CPPFLAGS="-I/tools/include "

# Configure source
./configure --prefix=/tools --enable-tiny

# Build and install to toolchain
make && make install

# Clean up
unset LDFLAGS CPPFLAGS
