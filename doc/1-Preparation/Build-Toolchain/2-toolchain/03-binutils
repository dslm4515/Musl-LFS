# Tool Chain: Binutils
# Build and install as mlfs

# Compile in dedicated build directory
mkdir -v build && cd build

# Create a cache file to configure
# the source to build with cross-tools
cp -v ../../files/ct-config.cache config.cache

# Configure
../configure --prefix=/tools            \
             --with-lib-path=/tools/lib \
             --build=${MLFS_HOST}       \
             --host=${MLFS_TARGET}      \
             --target=${MLFS_TARGET}    \
             --disable-nls              \
             --disable-werror           \
             --with-sysroot \
             --enable-gprofng=no \
             --cache-file=config.cache
# Build
make

# Install
make install

# Build and install linker that will be used later 
# after adjusting toolchain
make -C ld clean
make -C ld LIB_PATH=/usr/lib:/lib 
cp -v ld/ld-new /tools/bin

