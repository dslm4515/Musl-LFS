# Toolchain: Perl 
# Build and install as mlfs

# Zlib not built, build the bundled zlib
export BUILD_ZLIB=True

# Avoid building the bundled bzip2
export BUILD_BZIP2=0

# Make sure the bundled bzip2 is not compiled
rm -rf cpan/Compress-Raw-Bzip2/bzip2-src
sed -i '/\(bzip2\|zzz\)-src/d' MANIFEST

# Set additional flags
export  CFLAGS=" -DNO_POSIX_2008_LOCALE"
export CFLAGS+=" -D_GNU_SOURCE"

export PVER="5.40"

# Configure source
sh Configure -des -Dprefix=/tools \
   -Dlibs=-lm -Uloclibpth -Ulocincpth \
   -Dcccdlflags='-fPIC' -Dccdlflags='-rdynamic' \
   -Dccflags='-Wno-implicit-function-declaration' \
   -Dusevendorprefix -Dvendorprefix=/tools \
   -Dprivlib=/tools/lib/perl5/${PVER}/core_perl \
   -Darchlib=/tools/lib/perl5/${PVER}/core_perl \
   -Dsitelib=/tools/lib/perl5/${PVER}/site_perl \
   -Dsitearch=/tools/lib/perl5/${PVER}/site_perl \
   -Dvendorlib=/tools/lib/perl5/${PVER}/vendor_perl \
   -Dvendorarch=/tools/lib/perl5/${PVER}/vendor_perl

# Build 
make 

# Copy only what is needed:
cp -v perl cpan/podlators/scripts/pod2man /tools/bin &&
mkdir -pv /tools/lib/perl5/${PVER}/core_perl    &&
cp -Rv lib/* /tools/lib/perl5/${PVER}/core_perl/

unset BUILD_ZLIB BUILD_BZIP2 CFLAGS PVER 
