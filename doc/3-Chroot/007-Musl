# Final System: Musl Libc
# This section is done in Chroot environment

# For i686(32 bit), there is a rounding error that
# causes fonts to not display for SeaMonkey and 
# Palemoon browsers:
case $(uname -m) in
    i686 | i586) patch -Np1 -i ../patches/musl-mlfs/i686-fix-rounding.patch
    ;;
esac

# Fix paths for utmp & wtmp:
patch -Np1 -i ../patches/musl-mlfs/fix-utmp-wtmp-paths.patch

# Make scheduler functions Linux-compatible
patch -Np1 -i ../patches/musl-mlfs/change-scheduler-functions-Linux-compatib.patch 

# Additional patches from Alpine Linux:
patch -Np1 -i ../patches/musl-alpine/handle-aux-at_base.patch
patch -Np1 -i ../patches/musl-alpine/ldso-fix-non-functional-fix-to-early-dynamic-PAGE_SI.patch 
atch -Np1 -i ../patches/musl-alpine/loongarch64-Add-lsx-and-lasx-vector-structure-defini.patch

# Configure 
./configure --prefix=/usr \
            --sysconfdir=/etc \
            --localstatedir=/var \
            --disable-gcc-wrapper \
            --enable-debug

# Build and install 
make && make  install

# provide minimal libssp_nonshared.a so we don't need libssp from gcc
gcc -fpie -Wno-implicit-int -c ../files/__stack_chk_fail_local.c -o __stack_chk_fail_local.o
gcc-ar r libssp_nonshared.a __stack_chk_fail_local.o
cp -v libssp_nonshared.a /usr/lib/

# Create link for ldd:
ln -sv /usr/lib/libc.so ../bin/ldd

# Create a compatibility link for rust
ln -sv libc.so /usr/lib/libc.musl-$MCA.so.1 

# Fix a link
rm -rf /lib/ld-musl*
ln -sv libc.so  /usr/lib/ld-musl-$MCA.so.1

# Install a ldconfig script.
# This is handy for package managers to add/remove library paths
# without directly modifying the ld-musl-$MCA.path file.
# If not using package managers, simply create ldconfig as a link
# to true (ln -sv ../bin/true /usr/sbin/ldconfig)
install -v -D -m755 ../files/musl-adelie/ldconfig /usr/sbin/
chmod -v +x /usr/sbin/ldconfig
mkdir -pv $BUILD/etc/ld-musl-${MCA}.d
cat > $BUILD/etc/ld-musl-${MCA}.d/default <<EOF
/lib
/usr/lib
EOF

# Create config for dynamic library loading:
cat > /etc/ld-musl-$MCA.path << "EOF"
/lib
/usr/local/lib
/usr/lib
EOF

# Header will be provided by skarnet's umtps
rm -v /usr/include/utmpx.h 

# Some packages [outside MLFS] may expect ld-musl-i686.so.1 
# instead of ld-musl-i386.so.1:
case $(uname -m) in
     i686) ln -sv ../usr/lib/libc.so  ${BUILD}/lib/ld-musl-i686.so.1 ;;
esac

unset ARCH

